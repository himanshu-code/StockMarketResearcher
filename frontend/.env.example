# URL of the backend API server for client-side Axios requests.
# In production (cross-origin), set this to the backend URL.
# In local development, leave blank — Next.js rewrites will proxy requests to the backend.
NEXT_PUBLIC_API_BASE_URL=

# Backend URL used by Next.js rewrites (server-side proxy). Only needed in Docker or custom setups.
# Defaults to http://localhost:8000 if not set.
BACKEND_URL=http://localhost:8000
