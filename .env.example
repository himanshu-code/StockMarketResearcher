# LLM Configuration
LLM_PROVIDER=openai # Options: openai, gemini, mistral
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
MISTRAL_API_KEY=your_mistral_api_key

# Custom Base URL (Optional, for OpenAI-compatible proxies/services)
OPENAI_BASE_URL=

# External API Integrations
NEWSAPI_KEY=your_newsapi_api_key # Required for News Sentiment Agent

# Databases & Caching
DATABASE_URL=sqlite+aiosqlite:///./data/stock_market.db # Local SQLite path
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_market_researcher # Docker/Production Postgres
REDIS_URL=redis://localhost:6379 # Caching store

# Langfuse Observability & LLM-as-a-Judge Evaluations
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com # Or your self-hosted host
